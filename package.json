{
  "name": "frc-packs",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "homepage": "https://github.com/STMARobotics/frc-packs#readme",
  "bugs": {
    "url": "https://github.com/STMARobotics/frc-packs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STMARobotics/frc-packs.git"
  },
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "npm run build --workspace=web && rm -rf cdk/.build/site && mkdir -p cdk/.build/site && cp -a web/dist/. cdk/.build/site/ && cp -a data/photos cdk/.build/site/photos && cp -a data/packs cdk/.build/site/packs",
    "build:backend": "bash server/build.sh",
    "cdk:synth": "npm run synth --workspace=cdk",
    "cdk:diff": "npm exec -w cdk -- cdk diff --",
    "cdk:deploy": "npm run build && npm run deploy --workspace=cdk",
    "cdk:test": "npm run test --workspace=cdk",
    "ui:test": "npm run test --workspace=web",
    "server:test": "cargo test --manifest-path server/Cargo.toml --locked",
    "check:activity-contract": "node scripts/check-activity-contract.cjs"
  },
  "workspaces": [
    "cdk",
    "server",
    "web"
  ],
  "dependencies": {
    "concurrently": "^10.0.6"
  }
}
